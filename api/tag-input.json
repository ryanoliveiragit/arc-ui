{"exports":[{"name":"TagInput","kind":"component","file":"registry/components/tag-input/tag-input.tsx"}],"components":[{"name":"TagInput","doc":"Tags keep the field still: a new tag blurs in where its text was typed while the caret glides aside, a removed tag leaves its slot and the rest glide in, and the shell follows wrapped rows on a spring. Backspace or the arrow keys pick a tag first, a ring glides to it, and the next Backspace removes it.","props":"TagInputProps","defaults":{"defaultValue":"[]","placeholder":"\"Add a tag\""},"file":"registry/components/tag-input/tag-input.tsx"}],"types":[{"name":"TagInputProps","exported":true,"doc":"","file":"registry/components/tag-input/tag-input.tsx","kind":"interface","extends":[],"members":[{"name":"label","optional":false,"type":"string","doc":""},{"name":"value","optional":true,"type":"string[]","doc":""},{"name":"defaultValue","optional":true,"type":"string[]","doc":""},{"name":"onValueChange","optional":true,"type":"(value: string[]) => void","doc":""},{"name":"placeholder","optional":true,"type":"string","doc":""},{"name":"description","optional":true,"type":"string","doc":""},{"name":"id","optional":true,"type":"string","doc":""}]}]}
