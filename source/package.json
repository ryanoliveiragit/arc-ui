{
  "name": "ryan-ui",
  "version": "0.1.0",
  "private": true,
  "description": "ryan-ui: componentes e blocos React com movimento, em CSS modules e tokens de design. Baseado no núcleo open source (MIT) do Arc.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/build-catalog.mjs && node scripts/build-api.mjs && node scripts/build-registry.mjs && node scripts/build-docs.mjs && node scripts/build-markdown.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "catalog": "node scripts/build-catalog.mjs",
    "registry": "node scripts/build-registry.mjs",
    "test:demos": "node scripts/test-demos.mjs",
    "check": "npm run typecheck && npm run build && npm run test:demos",
    "docs": "node scripts/build-docs.mjs",
    "markdown": "node scripts/build-markdown.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright-core": "^1.65.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
